# Django
DJANGO_SETTINGS_MODULE=config.settings.production
SECURE_SSL_REDIRECT=False

# Generate with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Docker PostgreSQL connection
DATABASE_URL=postgresql://agsuite_user:YOUR_POSTGRES_PASSWORD@postgres:5432/agsuite_erp

# Docker Redis
# Docker Redis - OPTIONAL. Uncomment these only when you start the stack with
#   docker compose --profile full up -d
# Without them the app runs on PostgreSQL alone (background threads + DB fallbacks).
# CELERY_BROKER_URL=redis://redis:6379/0
# CELERY_RESULT_BACKEND=redis://redis:6379/0
# REDIS_URL=redis://redis:6379/0

# Local Docker access
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost
FRONTEND_URL=http://localhost

# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# NetSuite
NETSUITE_REDIRECT_URI=http://localhost:8000/api/v1/netsuite/callback/

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Email / SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
DEFAULT_FROM_NAME=AGSuite ERP

# ---------------------------------------------------------------------
# Optional infrastructure (all OPTIONAL; the app runs without Redis/Celery)
# ---------------------------------------------------------------------
# Redis is only an accelerator (OCR cache / lock / rate limiter). Leave
# REDIS_URL empty to fall back to CELERY_BROKER_URL when that is a redis:// URL.
# REDIS_URL=redis://redis:6379/0
# REDIS_ENABLED=true            # false = never touch Redis
# REDIS_RETRY_INTERVAL=30       # seconds an up/down probe result is trusted
# REDIS_CONNECT_TIMEOUT=1
# REDIS_SOCKET_TIMEOUT=2
# CELERY_BROKER_CONNECTION_TIMEOUT=2   # fail fast when the broker is down

# Gunicorn (read by backend/gunicorn.conf.py)
# GUNICORN_WORKERS=2            # or WEB_CONCURRENCY
# GUNICORN_THREADS=1
# GUNICORN_TIMEOUT=300          # platform request limits (e.g. Catalyst 30s) still apply
 
# ---------------------------------------------------------------------
# OCR background execution (all OPTIONAL - defaults work on any host)
# ---------------------------------------------------------------------
# auto     = Celery if a broker AND a live worker are detected, else threads
# celery   = prefer Celery (still degrades to threads if unreachable)
# thread   = in-process background threads
# inline   = no background execution
# external = web only queues; run `python manage.py run_ocr_worker` elsewhere
# OCR_EXECUTION_MODE=auto
# OCR_BACKGROUND_WORKERS=2
# OCR_JOB_LEASE_SECONDS=300           # a job that stops renewing is recovered
# OCR_JOB_MAX_RETRIES=5
# OCR_JOB_RETRY_BASE_SECONDS=15       # back-off: base * 2**attempt
# OCR_SINGLE_TIME_BUDGET_SECONDS=180  # inline attempt, then handed to background
#                                     # (defaults to 20 automatically on Catalyst)
# OCR_SINGLE_ASYNC=false              # true = never process inline, always poll
# OCR_MULTIPLE_ENABLED=true

+
+# ---------------------------------------------------------------------
+# File storage (OPTIONAL) - see DEPLOY_ANYWHERE.md
+# ---------------------------------------------------------------------
+# auto  = local disk if MEDIA_ROOT is writable, otherwise PostgreSQL
+# local = MEDIA_ROOT   db = PostgreSQL   s3 = S3-compatible bucket
+# OCR_STORAGE_BACKEND=auto
+# OCR_S3_BUCKET=
+# OCR_S3_REGION=
+# OCR_S3_ENDPOINT_URL=
+# OCR_S3_ACCESS_KEY_ID=
+# OCR_S3_SECRET_ACCESS_KEY=
+# NETSUITE_BACKGROUND_WORKERS=1