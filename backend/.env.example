# Django core
SECRET_KEY=your-secret-key
DEBUG=True
ALLOWED_HOSTS=*

# PostgreSQL(DB credentials)
DATABASE_URL=your-database-url

# Field-level encryption (NetSuite client_secret/access_token/refresh_token
# at rest). Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this stable across deploys — rotating it makes existing encrypted
# rows unreadable.
FIELD_ENCRYPTION_KEY=

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS (comma-separated origins allowed to call this API)
CORS_ALLOWED_ORIGINS=your-frontend-url

# Frontend (used to build redirect targets, e.g. the NetSuite OAuth callback)
FRONTEND_URL=your-frontend-url

# NetSuite OAuth 2.0 (Authorization Code Grant)
# Create an Integration record in NetSuite (Setup > Integration > Manage
# Integrations > New) with the Auth Code Grant enabled to obtain these.
# For LOCAL dev:  http://localhost:8000/api/v1/netsuite/callback/
# For PRODUCTION: https://erp-pulse-backend.onrender.com/api/v1/netsuite/callback/
# The NetSuite Integration record must have BOTH redirect URIs registered.
NETSUITE_REDIRECT_URI=http://localhost:8000/api/v1/netsuite/callback/


# AI Provider (OpenAI). Chat responses gracefully fall back to a clean
# "not configured" error if left blank — the app does not crash without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Email Services
# SMTP (works on localhost). For production on Render, SMTP ports are blocked
# — use Brevo HTTP API instead.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=your-email@gmail.com
DEFAULT_FROM_NAME=ERP Pulse

# Brevo HTTP API (for production on Render where SMTP ports are blocked)
# Get a valid API key from Brevo dashboard > SMTP & API > API Keys
# Format: xkeysib-...
# Leave empty to fall back to SMTP (works on localhost, fails on Render)
BREVO_API_KEY=
