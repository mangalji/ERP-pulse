# Django core
SECRET_KEY=your-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DATABASE_NAME=erp_pulse
DATABASE_USER=erp_pulse_user
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=5432

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS (comma-separated origins allowed to call this API)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Frontend (used to build redirect targets, e.g. the NetSuite OAuth callback)
FRONTEND_URL=http://localhost:5173

# NetSuite OAuth 2.0 (Authorization Code Grant)
# Create an Integration record in NetSuite (Setup > Integration > Manage
# Integrations > New) with the Auth Code Grant enabled to obtain these.
NETSUITE_ACCOUNT_ID=
NETSUITE_CLIENT_ID=
NETSUITE_CLIENT_SECRET=
NETSUITE_REDIRECT_URI=http://localhost:8000/api/v1/netsuite/callback/


# AI Provider (OpenAI). Chat responses gracefully fall back to a clean
# "not configured" error if left blank — the app does not crash without it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
