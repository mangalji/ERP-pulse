# ============================================================
# AGSuite ERP - Backend Environment Variables Template
# ============================================================

# Django Core & Settings
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=your-production-secret-key-here
DEBUG=False
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-app-name.catalystappsail.com

# PostgreSQL / Supabase Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
LOCAL_DB_NAME=erp_pulse_local
TEST_DB_NAME=erp_pulse_test

# Redis / Celery (required in production)
# For Docker Compose production: redis://redis:6379/0
# For managed cloud Redis: redis://:<password>@<host>:<port>/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Field-level Encryption (NetSuite tokens/credentials at rest)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=your-fernet-encryption-key-here

# Security, CORS & CSRF
CORS_ALLOWED_ORIGINS=https://your-app-name.catalystserverless.com,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://your-app-name.catalystserverless.com,http://localhost:5173
FRONTEND_URL=https://your-app-name.catalystserverless.com
JWT_AUTH_COOKIE_SAMESITE=None
JWT_AUTH_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True

# JWT Token Lifetimes   
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=200
JWT_REFRESH_TOKEN_LIFETIME_DAYS=20

# NetSuite OAuth 2.0 Integration Callback
NETSUITE_REDIRECT_URI=https://your-app-name.catalystappsail.com/api/v1/netsuite/callback/

# AI Provider Configuration (Optional)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Email Configuration (SMTP / Brevo)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=your-email@example.com
DEFAULT_FROM_NAME=AGSuite ERP
BREVO_API_KEY=your-brevo-api-key

# Logging Configuration
LOG_LEVEL=INFO
DJANGO_DB_LOG_LEVEL=WARNING
MONITORING_LOG_LEVEL=INFO