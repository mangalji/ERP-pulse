# ============================================================
# AGSuite ERP - Backend Environment Variables Template
# ============================================================

# Django Core & Settings

# set DJANGO_SETTINGS_MODULE to config.settings.production if in production, set local if in local
DJANGO_SETTINGS_MODULE=

SECRET_KEY=your-production-secret-key-here
DEBUG=False
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-app-name.catalystappsail.com

# PostgreSQL / Supabase Database
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
LOCAL_DB_NAME=erp_pulse_local
TEST_DB_NAME=erp_pulse_test

# Redis / Celery (required in production)
# For Docker Compose production: redis://redis:6379/0
# For managed cloud Redis: redis://:<password>@<host>:<port>/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# Field-level Encryption (NetSuite tokens/credentials at rest)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=your-fernet-encryption-key-here

# Security, CORS & CSRF
JWT_AUTH_COOKIE_SAMESITE=None
JWT_AUTH_COOKIE_SECURE=True

# if in production config it as a True else False
SECURE_SSL_REDIRECT=True

CSRF_COOKIE_SAMESITE=None
LATENCY_DIAGNOSTICS = true
REQUEST_LOG_TO_DATABASE=false

# JWT Token Lifetimes   
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=200
JWT_REFRESH_TOKEN_LIFETIME_DAYS=20

# NetSuite OAuth 2.0 Integration Callback
NETSUITE_REDIRECT_URI=https://your-app-name.catalystappsail.com/api/v1/netsuite/callback/

# Email Configuration (SMTP / Brevo)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=your-email@example.com
DEFAULT_FROM_NAME=AGSuite ERP

# if want to use in production use third party mail sender(I use BREVO.)
BREVO_API_KEY=

# Logging Configuration
LOG_LEVEL=INFO
DJANGO_DB_LOG_LEVEL=WARNING
MONITORING_LOG_LEVEL=INFO

OCR_MULTIPLE_ENABLED=True

OCR_STORAGE_BACKEND=db

# these 2 API keys are using for checking whether email is exist or not. if one hit his limit 
# transfer to another
ABSTRACT_EMAIL_VALIDATION_API_KEY=
HUNTER_API_KEY=


# CORS (comma-separated origins allowed to call this API)
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Frontend (used to build redirect targets, e.g. the NetSuite OAuth callback)
FRONTEND_URL=http://localhost:5173
# Explicit OCR actions per upload (separate from automatic provider/worker retries)
# OCR_MANUAL_RETRY_LIMIT=4
